# ============================================
# Blockchain
# ============================================
# Local Hardhat: http://127.0.0.1:8545  (Sepolia: your RPC URL)
VITE_RPC_URL=http://127.0.0.1:8545

# OPTIONAL override. The contract address + chain id normally come from
# frontend/src/lib/deployment.json, which the deploy script writes automatically.
VITE_CONTRACT_ADDRESS=

# ============================================
# Backend API (optional SIWE session)
# ============================================
VITE_API_BASE_URL=http://localhost:4000

# ============================================
# IPFS (Pinata) — optional; leave JWT empty to disable uploads
# ============================================
VITE_PINATA_JWT=
VITE_GATEWAY_URL=gateway.pinata.cloud

# ============================================
# WalletConnect (optional, for mobile wallets)
# ============================================
VITE_WALLETCONNECT_ID=

# NOTE: ZK artifacts are served from /zk/ and produced by `cd zk && ./build.sh`.
# No VITE_WASM/ZKEY vars are needed.
